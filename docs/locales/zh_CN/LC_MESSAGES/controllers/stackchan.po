#: ../../source/controllers/stackchan.rst:24
msgid "Supported Display Fonts"
msgstr "支持的显示字体"

#: ../../source/controllers/stackchan.rst:26
msgid "The StackChan firmware includes the following Montserrat fonts for LVGL and M5UI: ``lv.font_montserrat_12``, ``lv.font_montserrat_14``, ``lv.font_montserrat_16``, ``lv.font_montserrat_18``, ``lv.font_montserrat_24``, ``lv.font_montserrat_40``, ``lv.font_montserrat_44``, and ``lv.font_montserrat_48``."
