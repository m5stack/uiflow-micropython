msgstr ""

#: ../../source/unit/servos8_v2.rst:20 972df68ac2b942da9730ee868bd6c8c7
msgid "Constants"
msgstr "Constants"

#: ../../source/unit/servos8_v2.rst:22 f6d76c02f98d40b98ae9c780acce7c24
msgid "Use the following constants with ``set_channel_mode()``:"
msgstr "以下常量用于 ``set_channel_mode()``："

#: ../../source/unit/servos8_v2.rst:24 82b739f640734b1d80b61e8d1097bfb5
msgid "``MODE_INPUT``: GPIO input mode."
msgstr "``MODE_INPUT``：GPIO 输入模式。"

#: ../../source/unit/servos8_v2.rst:25 387923d548004ee2aea0b90b965fb5be
msgid "``MODE_OUTPUT``: GPIO output mode."
msgstr "``MODE_OUTPUT``：GPIO 输出模式。"

#: ../../source/unit/servos8_v2.rst:26 24986d9cf6154f37a517c1b70c71423e
msgid "``MODE_ADC``: ADC input mode."
msgstr "``MODE_ADC``：ADC 输入模式。"

#: ../../source/unit/servos8_v2.rst:27 3d8bbeeb45b444f6b8baf3102a602ba2
msgid "``MODE_SERVO``: Servo control mode."
msgstr "``MODE_SERVO``：舵机控制模式。"

#: ../../source/unit/servos8_v2.rst:28 36ab0ae368a94580844b53d52b58cc24
msgid "``MODE_RGB``: RGB output mode for WS2812 LEDs."
msgstr "``MODE_RGB``：用于 WS2812 灯珠的 RGB 输出模式。"

#: ../../source/unit/servos8_v2.rst:29 2c94852b3d804f51a8d09eb1698c010d
msgid "``MODE_PWM``: PWM duty output mode."
msgstr "``MODE_PWM``：PWM 占空比输出模式。"

#: ../../source/unit/servos8_v2.rst:31 796ab4c4664d4f0ca8a07059f29265e0
msgid ""
"Use ``PULL_NONE``, ``PULL_UP``, or ``PULL_DOWN`` with ``set_input_pull()``."
msgstr ""
"调用 ``set_input_pull()`` 时可使用 ``PULL_NONE``、``PULL_UP`` 或 "
"``PULL_DOWN``。"

#: ../../source/unit/servos8_v2.rst:36 dcbeb8d711fe4f74bc6e1881c48787cc
msgid ""
"Channels 0-3 share one PWM frequency, and channels 4-7 share another. "
"Setting the frequency of one channel changes every channel in the same "
"group. Selecting servo mode sets the channel's shared group to 50 Hz."
msgstr ""
"通道 0-3 共享一个 PWM 频率，通道 4-7 共享另一个 PWM 频率。设置任一通道的频率"
"会改变同组所有通道的频率。选择舵机模式时，会将该通道所在共享频率组设置为 50 "
"Hz。"

