#: of unit.cardkb.CardKBI2C:1
msgid "CardKB unit driver over I2C communication."
msgstr "基于 I2C 通信的 CardKB 单元驱动程序。"

#: of unit.cardkb.CardKBI2C:3
msgid "The I2C bus instance."
msgstr "I2C 总线实例。"

#: of unit.cardkb.CardKBI2C:4
msgid "The I2C address of the CardKB unit. Defaults to ``0x5F``."
msgstr "CardKB 单元的 I2C 地址。默认值为 ``0x5F``。"

#: of unit.cardkb.CardKBESPNOW:3 unit.cardkb.CardKBI2C:5
#: unit.cardkb.CardKBUART:5
