+  void M5Unified::_speaker_tone_cb_corematrix(void* args, float frequency, uint8_t volume)
+  {
+#if defined (CONFIG_IDF_TARGET_ESP32C61)
+    auto self = (M5Unified*)args;
+    auto& ioe1 = static_cast<M5IOE1_Class&>(self->getIOExpander(0));
+    if (frequency > 0 && volume)
+    {
+      ioe1.digitalWrite(M5IOE1_Class::gpio2, false);
+      ioe1.setHighImpedance(M5IOE1_Class::gpio2, false);
+      ioe1.setDirection(M5IOE1_Class::gpio2, true);
+      ioe1.setHighImpedance(M5IOE1_Class::gpio11, false);
+      ioe1.setDirection(M5IOE1_Class::gpio11, true);
+      ioe1.setPwmDuty12bit(M5IOE1_Class::pwm_ch3, 0, pwm_polarity_t::normal, false);
+      ioe1.setPwmFrequency(lroundf(frequency));
+      ioe1.setPwmDuty12bit(M5IOE1_Class::pwm_ch3, ((uint16_t)volume * 2048 + 127) / 255);
+      ioe1.digitalWrite(M5IOE1_Class::gpio2, true);
+    }
+    else
+    {
+      ioe1.digitalWrite(M5IOE1_Class::gpio2, false);
+      ioe1.setPwmDuty12bit(M5IOE1_Class::pwm_ch3, 0, pwm_polarity_t::normal, false);
+    }
+#else
+    (void)args;
+    (void)frequency;
+    (void)volume;
+#endif
+  }
+
   bool M5Unified::_speaker_enabled_cb_cores3(void* args, bool enabled)
   {
     (void)args;
