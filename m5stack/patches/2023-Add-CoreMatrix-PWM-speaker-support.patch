@@ -2436,6 +2468,13 @@ static constexpr const uint8_t _pin_table_mbus[][31] = {
       switch (_board)
       {
 #if defined (M5UNIFIED_PC_BUILD)
+#elif defined (CONFIG_IDF_TARGET_ESP32C61)
+      case board_t::board_M5CoreMatrix:
+        if (cfg.internal_spk)
+        {
