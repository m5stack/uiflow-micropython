       case board_t::board_ArduinoNessoN1:
@@ -2893,9 +2932,10 @@ static constexpr const uint8_t _pin_table_mbus[][31] = {
       Mic.setCallback(this, mic_enable_cb);
       Mic.config(mic_cfg);
     }
-    if (spk_cfg.pin_data_out >= 0)
