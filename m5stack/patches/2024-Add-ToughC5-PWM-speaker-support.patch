+  void M5Unified::_speaker_tone_cb_toughc5(void* args, float frequency, uint8_t volume)
+  {
+#if defined (CONFIG_IDF_TARGET_ESP32C5)
+    auto self = (M5Unified*)args;
+    auto& pm1 = self->Power.M5pm1;
+    if (frequency > 0 && volume)
+    {
+      pm1.setGPIOMode(M5PM1_Class::gpio4, M5PM1_Class::output);
+      pm1.setGPIOFunction(M5PM1_Class::gpio4, M5PM1_Class::special);
+      pm1.setPwmDuty12bit(M5PM1_Class::pwm_ch1, 0, pwm_polarity_t::normal, false);
+      pm1.setPwmFrequency(lroundf(frequency));
+      pm1.setPwmDuty12bit(M5PM1_Class::pwm_ch1, ((uint16_t)volume * 2048 + 127) / 255);
+    }
+    else
+    {
+      pm1.setPwmDuty12bit(M5PM1_Class::pwm_ch1, 0, pwm_polarity_t::normal, false);
+    }
+#else
+    (void)args;
+    (void)frequency;
+    (void)volume;
+#endif
+  }
