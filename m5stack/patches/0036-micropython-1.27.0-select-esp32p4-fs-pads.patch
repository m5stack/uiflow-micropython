--- micropython.orig/ports/esp32/modmachine.c
+++ micropython/ports/esp32/modmachine.c
@@ -260,9 +260,9 @@ static mp_int_t mp_machine_reset_cause(v
 }

 #if MICROPY_ESP32_USE_BOOTLOADER_RTC
+#include "usb.h"
 #if !CONFIG_IDF_TARGET_ESP32P4
 #include "soc/rtc_cntl_reg.h"
-#include "usb.h"
 #else
 #include "soc/lp_system_reg.h"
 #endif
@@ -273,6 +273,10 @@ static mp_int_t mp_machine_reset_cause(v
 #endif

 MP_NORETURN static void machine_bootloader_rtc(void) {
+    #if CONFIG_IDF_TARGET_ESP32P4 && MICROPY_HW_USB_CDC && !MICROPY_HW_USB_HS && defined(MICROPY_HW_USB_FS_PHY)
+    // Restore USB-C to Serial/JTAG before the ROM download-mode reset.
+    usb_usj_mode();
+    #endif
     #if CONFIG_IDF_TARGET_ESP32S3 && MICROPY_HW_USB_CDC
     usb_usj_mode();
     usb_dc_prepare_persist();
