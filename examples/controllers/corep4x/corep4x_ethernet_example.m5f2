{"version":"V2.0","versionNumber":"V2.5.1","type":"corep4x","components":[{"name":"page0","type":"lvgl_page","layer":0,"screenId":"builtin","screenName":"","id":"page0","createTime":0,"backgroundColor":"#080808","isLVGL":true,"isSelected":true},{"name":"label_title","type":"lvgl_label","id":"label_title","layer":1,"screenId":"builtin","screenName":"","createTime":1,"x":24,"y":24,"pageId":"page0","isLVGL":true,"isSelected":false,"text":"Ethernet","font":"lv.font_montserrat_24","color":"#F4F4F5","backgroundColor":"#080808","bg_opacity":0},{"name":"label_link_name","type":"lvgl_label","id":"label_link_name","layer":2,"screenId":"builtin","screenName":"","createTime":2,"x":44,"y":108,"pageId":"page0","isLVGL":true,"isSelected":false,"text":"Link","font":"lv.font_montserrat_18","color":"#9A9A9F","backgroundColor":"#080808","bg_opacity":0},{"name":"label_link","type":"lvgl_label","id":"label_link","layer":3,"screenId":"builtin","screenName":"","createTime":3,"x":270,"y":108,"pageId":"page0","isLVGL":true,"isSelected":false,"text":"Starting","font":"lv.font_montserrat_18","color":"#FFB84D","backgroundColor":"#080808","bg_opacity":0},{"name":"label_ip_name","type":"lvgl_label","id":"label_ip_name","layer":4,"screenId":"builtin","screenName":"","createTime":4,"x":44,"y":148,"pageId":"page0","isLVGL":true,"isSelected":false,"text":"IP","font":"lv.font_montserrat_18","color":"#9A9A9F","backgroundColor":"#080808","bg_opacity":0},{"name":"label_ip","type":"lvgl_label","id":"label_ip","layer":5,"screenId":"builtin","screenName":"","createTime":5,"x":220,"y":148,"pageId":"page0","isLVGL":true,"isSelected":false,"text":"--","font":"lv.font_montserrat_18","color":"#F4F4F5","backgroundColor":"#080808","bg_opacity":0},{"name":"label_date","type":"lvgl_label","id":"label_date","layer":6,"screenId":"builtin","screenName":"","createTime":6,"x":125,"y":200,"pageId":"page0","isLVGL":true,"isSelected":false,"text":"---- -- --","font":"lv.font_montserrat_24","color":"#F4F4F5","backgroundColor":"#080808","bg_opacity":0},{"name":"label_hour","type":"lvgl_label","id":"label_hour","layer":7,"screenId":"builtin","screenName":"","createTime":7,"x":76,"y":242,"pageId":"page0","isLVGL":true,"isSelected":false,"text":"--","font":"lv.font_montserrat_48","color":"#8EDA91","backgroundColor":"#080808","bg_opacity":0},{"name":"label_minute","type":"lvgl_label","id":"label_minute","layer":8,"screenId":"builtin","screenName":"","createTime":8,"x":192,"y":242,"pageId":"page0","isLVGL":true,"isSelected":false,"text":"--","font":"lv.font_montserrat_48","color":"#8EDA91","backgroundColor":"#080808","bg_opacity":0},{"name":"label_second","type":"lvgl_label","id":"label_second","layer":9,"screenId":"builtin","screenName":"","createTime":9,"x":308,"y":242,"pageId":"page0","isLVGL":true,"isSelected":false,"text":"--","font":"lv.font_montserrat_48","color":"#8EDA91","backgroundColor":"#080808","bg_opacity":0},{"name":"label_colon1","type":"lvgl_label","id":"label_colon1","layer":10,"screenId":"builtin","screenName":"","createTime":10,"x":179,"y":238,"pageId":"page0","isLVGL":true,"isSelected":false,"text":":","font":"lv.font_montserrat_48","color":"#8EDA91","backgroundColor":"#080808","bg_opacity":0},{"name":"label_colon2","type":"lvgl_label","id":"label_colon2","layer":11,"screenId":"builtin","screenName":"","createTime":11,"x":295,"y":238,"pageId":"page0","isLVGL":true,"isSelected":false,"text":":","font":"lv.font_montserrat_48","color":"#8EDA91","backgroundColor":"#080808","bg_opacity":0},{"name":"label_ntp","type":"lvgl_label","id":"label_ntp","layer":12,"screenId":"builtin","screenName":"","createTime":12,"x":125,"y":320,"pageId":"page0","isLVGL":true,"isSelected":false,"text":"Waiting","font":"lv.font_montserrat_18","color":"#9A9A9F","backgroundColor":"#080808","bg_opacity":0},{"name":"sync_button","type":"lvgl_button","id":"sync_button","layer":13,"screenId":"builtin","screenName":"","createTime":13,"x":24,"y":388,"pageId":"page0","isLVGL":true,"isSelected":false,"width":432,"height":64,"text":"SYNC NTP","font":"lv.font_montserrat_18","color":"#F4F4F5","backgroundColor":"#303034"}],"resources":[{"hardware":["rtc","touch","ethernet"]}],"units":[],"hats":[],"caps":[],"chains":[],"bases":[],"plcmodules":[],"stamps":[],"tab5modules":[],"poep4modules":[],"i2cs":[],"chainBus":[],"blockly":"<block type=\"execute_code_import\" id=\"eth_mixed_1\" x=\"40\" y=\"40\"><field name=\"CODE\">import socket\nimport struct\nimport time\nimport lvgl as lv\nimport machine\nimport network\nimport M5\nfrom M5 import *\nimport m5ui\nfrom hardware import RTC\nBACKGROUND = 0x080808\nPANEL = 0x222224\nTEXT = 0xF4F4F5\nMUTED = 0x9A9A9F\nGOOD = 0x8EDA91\nWARNING = 0xFFB84D\nNTP_HOST = \"ntp.aliyun.com\"\nNTP_DELTA = 2208988800\nUTC_OFFSET = 8 * 60 * 60\nethernet = None\nrtc = None\npage = None\nlabel_link = None\nlabel_ip = None\nlabel_date = None\nlabel_hour = None\nlabel_minute = None\nlabel_second = None\nlabel_ntp = None\nsync_button = None\nlast_connected = None\nlast_update_ms = 0\nntp_epoch = None\nntp_ticks_ms = 0\nsync_pending = False\n\ndef query_ntp(host):\n    query = bytearray(48)\n    query[0] = 0x1B\n    address = socket.getaddrinfo(host, 123, 0, socket.SOCK_DGRAM)[0][-1]\n    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n    sock.settimeout(3)\n    try:\n        sock.sendto(query, address)\n        response = sock.recv(48)\n    finally:\n        sock.close()\n    return struct.unpack(\"!I\", response[40:44])[0] - NTP_DELTA\n\ndef format_datetime(epoch):\n    value = time.gmtime(epoch + UTC_OFFSET)\n    date_text = \"%04d-%02d-%02d\" % value[:3]\n    time_text = \"%02d:%02d:%02d\" % value[3:6]\n    return date_text, time_text\n\ndef set_label_color(label, color):\n    label.set_text_color(color, 255, lv.PART.MAIN | lv.STATE.DEFAULT)\n\ndef set_clock(epoch):\n    date_text, time_text = format_datetime(epoch)\n    label_date.set_text(date_text)\n    label_hour.set_text(time_text[0:2])\n    label_minute.set_text(time_text[3:5])\n    label_second.set_text(time_text[6:8])\n    set_label_color(label_hour, GOOD)\n    set_label_color(label_minute, GOOD)\n    set_label_color(label_second, GOOD)\n\ndef sync_time():\n    global ntp_epoch, ntp_ticks_ms\n\n    label_ntp.set_text(\"Syncing...\")\n    set_label_color(label_ntp, WARNING)\n    for attempt in range(1, 4):\n        try:\n            ntp_epoch = query_ntp(NTP_HOST)\n            ntp_ticks_ms = time.ticks_ms()\n            utc = time.gmtime(ntp_epoch)\n            rtc.init((utc[0], utc[1], utc[2], utc[3], utc[4], utc[5],\n                      utc[6], 0))\n            set_clock(ntp_epoch)\n            label_ntp.set_text(\"Synced / UTC+8\")\n            set_label_color(label_ntp, GOOD)\n            return True\n        except OSError as error:\n            time.sleep(1)\n    label_ntp.set_text(\"Sync failed\")\n    set_label_color(label_ntp, WARNING)\n    return False\n\ndef refresh_status():\n    global last_connected\n\n    connected = ethernet.isconnected()\n    ip = ethernet.ifconfig()[0] if connected else \"0.0.0.0\"\n    label_link.set_text(\"Connected\" if connected else \"No link\")\n    set_label_color(label_link, GOOD if connected else WARNING)\n    label_ip.set_text(ip)\n    last_connected = connected</field></block><block type=\"basic_on_setup\" id=\"setup_block\" deletable=\"false\" x=\"740\" y=\"40\"><mutation isBegin=\"true\" /><field name=\"UPDATEOP\">true</field><statement name=\"FUNC\"><block type=\"system_m5_begin\" id=\"eth_mixed_2\"><next><block type=\"lvgl_page_screen_load\" id=\"eth_mixed_3\"><field name=\"NAME\">page0</field><next><block type=\"execute_code\" id=\"eth_mixed_4\"><field name=\"CODE\">global ethernet, rtc, last_update_ms\nfor clock_label in (label_hour, label_minute, label_second):\n    clock_label.set_width(96)\n    clock_label.set_style_text_align(lv.TEXT_ALIGN.CENTER, lv.PART.MAIN)\nfor centered_label in (label_date, label_ntp):\n    centered_label.set_x(48)\n    centered_label.set_width(384)\n    centered_label.set_style_text_align(lv.TEXT_ALIGN.CENTER, lv.PART.MAIN)\nfor status_label in (label_link, label_ip):\n    status_label.set_x(164)\n    status_label.set_width(272)\n    status_label.set_style_text_align(lv.TEXT_ALIGN.RIGHT, lv.PART.MAIN)\nrtc = RTC()\nethernet = network.LAN(\n    0,\n    phy_addr=1,\n    phy_type=network.PHY_IP101,\n    mdc=machine.Pin(31),\n    mdio=machine.Pin(36),\n    power=machine.Pin(52),\n    ref_clk=machine.Pin(32),\n    tx_en=machine.Pin(33),\n    txd0=machine.Pin(41),\n    txd1=machine.Pin(35),\n    crs_dv=machine.Pin(28),\n    rxd0=machine.Pin(29),\n    rxd1=machine.Pin(30),\n)\nethernet.active(True)\nethernet.set_default_netif()\n\ndeadline = time.ticks_add(time.ticks_ms(), 30000)\nwhile not ethernet.isconnected() and time.ticks_diff(deadline, time.ticks_ms()) &gt; 0:\n    M5.update()\n    refresh_status()\n    time.sleep_ms(200)\nrefresh_status()\nif ethernet.isconnected():\n    sync_time()\nelse:\n    label_ntp.set_text(\"No network\")\n    set_label_color(label_ntp, WARNING)\nlast_update_ms = time.ticks_ms()</field></block></next></block></next></block></statement></block><block type=\"basic_on_loop\" id=\"loop_block\" deletable=\"false\" x=\"740\" y=\"640\"><mutation isUpdate=\"true\" /><field name=\"UPDATEOP\">true</field><statement name=\"FUNC\"><block type=\"execute_code\" id=\"eth_mixed_6\"><field name=\"CODE\">global last_update_ms, sync_pending, last_connected\nM5.update()\nif sync_pending:\n    sync_pending = False\n    if ethernet.isconnected():\n        sync_time()\n    else:\n        label_ntp.set_text(\"No network\")\n        set_label_color(label_ntp, WARNING)\nnow = time.ticks_ms()\nif time.ticks_diff(now, last_update_ms) &gt;= 1000:\n    last_update_ms = now\n    was_connected = last_connected\n    refresh_status()\n    if ethernet.isconnected() and was_connected is False:\n        sync_time()\n    if ntp_epoch is not None:\n        elapsed = time.ticks_diff(now, ntp_ticks_ms) // 1000\n        set_clock(ntp_epoch + elapsed)\ntime.sleep_ms(10)</field></block></statement></block><block type=\"lvgl_button_event\" id=\"eth_mixed_9\" x=\"740\" y=\"1040\"><field name=\"NAME\">sync_button</field><field name=\"OPTION\">CLICKED</field><statement name=\"FUNC\"><block type=\"execute_code\" id=\"eth_mixed_8\"><field name=\"CODE\">global sync_pending\nsync_pending = True</field></block></statement></block>","screen":[{"simulationName":"Built-in","type":"builtin","width":480,"height":480,"scale":0.58,"screenName":"","blockId":"","screenColorType":0,"rotation":0,"id":"builtin","createTime":1}],"logicWhenNum":0,"customList":[]}
